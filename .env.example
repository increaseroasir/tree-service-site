# SERVER-ONLY secrets. In AI Studio: Cloud → Secrets. Locally: copy to .env.
# Never prefix with VITE_. None of these reach the browser except META_PIXEL_ID,
# which is public by nature and is served through getPublicConfig().

# GoHighLevel / LeadConnector. Register a "Service Type" custom field in the
# client's location and paste its id. Missing any of these = form says
# "not connected" and refuses to post.
GHL_TRACKING_ID=
GHL_LOCATION_ID=
GHL_PROJECT_ID=
GHL_SERVICE_TYPE_FIELD_ID=

# Meta. Both required to fire; leave blank to run with no pixel at all.
# ONE pixel/dataset per site. NEVER put a test_event_code anywhere.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# Slack-compatible incoming webhook. Every lead-path failure posts here. Until
# a database exists, the CRM-failure alert carries the full lead so a CRM
# outage cannot lose it. Strongly recommended before paid traffic.
ALERT_WEBHOOK_URL=

# Local testing only (scripts/stub-server.mjs). Never set in production.
# GHL_TRACKING_ENDPOINT=http://localhost:9099/ghl
# META_GRAPH_BASE=http://localhost:9099/meta
